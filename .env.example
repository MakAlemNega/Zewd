# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# Required ----------------------------------------------------------------

# MongoDB connection string. Local dev example below; for Atlas use the
# connection string from your cluster's "Connect" dialog.
MONGODB_URI=mongodb://localhost:27017/ZewdDB

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every existing session (forces re-login).
SESSION_SECRET=

# Optional ------------------------------------------------------------------
# Every feature below degrades gracefully when left blank: the app keeps
# working, just without that feature (a warning is logged instead of a
# crash). Fill in whichever you're ready to use.

# RSVP notification emails via Resend (https://resend.com/api-keys).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Zewd <onboarding@resend.dev>

# Cover photo uploads via Vercel Blob (https://vercel.com/docs/vercel-blob).
BLOB_READ_WRITE_TOKEN=

# Error monitoring via Sentry (https://sentry.io).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps during production builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
